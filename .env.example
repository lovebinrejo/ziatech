# Resend API Key - get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your email address to receive enquiry form submissions
CONTACT_EMAIL=info@yourcompany.com

# WhatsApp number (with country code, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Company name displayed in emails / site
NEXT_PUBLIC_COMPANY_NAME=ZIA Tech Solutions

# Site URL (for OG images, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://yoursite.com
